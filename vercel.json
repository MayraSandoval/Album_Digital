{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "album": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "includeFiles": "**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "album" } }
  ]
}
